# Leave any line empty to run that feature in demo mode.
# Real values activate the feature in production.

# ── Supabase — auth, contact form, bookings, dashboard ────────────────
# Example: https://abcdefgh.supabase.co  +  ey...long-anon-key...
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase service role — required ONLY for /admin ────────────────
# WARNING: secret. Never expose to the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails authorized to access /admin
ADMIN_EMAILS=

# ── Chat assistant ──────────────────────────────────────────────────
# OpenRouter (https://openrouter.ai/keys): free models are tried first, then
# one cheap paid model so the chat keeps working when the free tier is busy
# (add a few dollars of credit for the paid fallback).
OPENROUTER_API_KEY=
# Optional overrides (comma-separated free list / paid model; '' disables paid):
# OPENROUTER_FREE_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# OPENROUTER_PAID_MODEL=anthropic/claude-haiku-5.5

# Anthropic — last-resort chat fallback. Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Resend — optional, email notifications on contact + booking ─────
RESEND_API_KEY=
EMAIL_FROM="Emad <onboarding@resend.dev>"
EMAIL_TO_ADMIN=

# ── Cloudflare Turnstile — CAPTCHA on sign in / sign up / password reset ─
# Public site key from https://dash.cloudflare.com/?to=/:account/turnstile
# Set this and deploy BEFORE enabling CAPTCHA protection in Supabase Auth
# (the secret key goes into Supabase, not here).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Public site URL — used for OAuth redirects, sitemap, RSS, OG ────
# In production set this to your Vercel URL (https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Set to "true" to bypass API rate limits (load tests only) ───────
RATE_LIMIT_DISABLED=
